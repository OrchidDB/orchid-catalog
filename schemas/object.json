  "$id": "urn:orchid:catalog:object:1",
  "title": "Orchid Catalog object v1",
  "oneOf": [
    {
      "$ref": "#/$defs/dataset"
    },
    {
      "$ref": "#/$defs/entity"
    },
    {
      "$ref": "#/$defs/relationship"
    },
    {
      "$ref": "#/$defs/computed_relationship"
    },
    {
      "$ref": "#/$defs/connector"
    },
    {
      "$ref": "#/$defs/retrieval"
