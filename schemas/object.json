  "$defs": {
    "dataset": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 16384
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          "uniqueItems": true
        },
        "owner": {
          "type": "string",
          "maxLength": 16384
        },
        "kind": {
          "const": "dataset"
        },
        "table": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
